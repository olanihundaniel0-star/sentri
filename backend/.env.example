# Optional. Absent -> explanations render via the deterministic template
# path (synthesizer_used: "template") instead of Claude. The demo runs
# without this set on purpose.
ANTHROPIC_API_KEY=your_key_here

# Required for POST /transfer to actually execute a transfer (live BMONI
# sandbox). Absent -> /transfer still scores and holds/silent-passes
# correctly, but execution 503s with "BMONI_API_KEY not configured".
BMONI_API_KEY=your_bmoni_sandbox_key_here

# Required, one per bridged demo identity (see seeds/identity_bridge.json),
# for POST /transfer to recognize that user_id as a bridged identity it can
# sign and execute a withdrawal for. Absent -> 400 "not a bridged demo
# identity with a server-held signing key" for that user_id. Generated by
# scripts/bmoni_onboard.py; never commit real values.
BMONI_SIGNING_KEY__user_001=
BMONI_SIGNING_KEY__user_002=

# Optional overrides below -- sensible defaults exist for all of these; only
# set them if you need something other than the default.
# BMONI_BASE_URL=https://embedded-dev.bmoni.com
# SENTRI_SEED_PATH=/absolute/path/to/alternate/seed/data.json
